# LOCAL DEVELOPMENT ONLY. Template for dev.env, which git ignores: `pnpm dev` (scripts/dev-env.mjs) creates dev.env from
# this file when it is missing and loads it via --env-file; `start` and deployments never read either file.
DRAFTROOM_DEV_AUTH=1
DRAFTROOM_DATA_DIR=../../.data
HOST=127.0.0.1
PORT=5859
PUBLIC_ORIGIN=http://127.0.0.1:5173
DRAFTROOM_SYNC_INTERNAL_URL=http://127.0.0.1:5858
# Dev-only secrets (rejected when NODE_ENV=production). Must match apps/sync/dev.env.
DRAFTROOM_TICKET_SECRET=dev-only-ticket-secret-change-me-0123456789abcdef
DRAFTROOM_INTERNAL_SECRET=dev-only-internal-secret-change-me-0123456789abcdef
AUTH_PROVIDER=dev
# Files on local disk under ${DRAFTROOM_DATA_DIR}/blobs (docs/M3-STORAGE-CONTRACTS.md §6). Staging and
# production use r2; the opt-in live R2 test reads .env.deploy.local instead of this file.
DRAFTROOM_BLOB_STORE=fs
# Preview-worker bearer token (dev placeholder, rejected when NODE_ENV=production). Must match
# apps/worker/dev.env.
DRAFTROOM_WORKER_TOKEN=dev-only-worker-token-change-me-0123456789
# Upload limits (docs/SECURITY-REVIEW-2026-09-27.md FC-1), defaults shown: storage quota and file count
# per workspace, uploads per signed-in person per minute. 413 / 429 past them.
# DRAFTROOM_WORKSPACE_QUOTA_MB=2048
# DRAFTROOM_WORKSPACE_MAX_FILES=5000
# DRAFTROOM_UPLOADS_PER_MINUTE=120
