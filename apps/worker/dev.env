# LOCAL DEVELOPMENT ONLY. Loaded by `pnpm dev` via --env-file; never by `start` or any deployment.
# Since milestone 3 the worker is an HTTP client of the api (/api/worker/*): no data dir, no database,
# no storage credentials. apps/api/dev.env listens on 127.0.0.1:5859.
DRAFTROOM_API_URL=http://127.0.0.1:5859
# Dev placeholder (refused when NODE_ENV=production). Must match apps/api/dev.env.
DRAFTROOM_WORKER_TOKEN=dev-only-worker-token-change-me-0123456789
WORKER_ID=dev-worker
# Snappier than the 2 s / 15 s defaults while developing.
WORKER_POLL_MS=500
WORKER_POLL_MAX_MS=2000
