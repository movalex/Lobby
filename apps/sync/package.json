{
  "name": "@draftroom/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=dev.env --watch --watch-preserve-output --watch-path=./src --watch-path=../../packages/canvas-schema/src --watch-path=../../packages/dev-assets/src --watch-path=../../packages/auth-tickets/src --watch-path=../../packages/permissions/src --watch-path=../../packages/blob-store/src src/server.ts",
    "start": "node src/server.ts",
    "backup:restore-drill": "node --env-file-if-exists=dev.env src/backup/restore-drill.ts",
    "backup:restore-board": "node --env-file-if-exists=dev.env src/backup/restore-board.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@draftroom/auth-tickets": "workspace:*",
    "@draftroom/blob-store": "workspace:*",
    "@draftroom/canvas-schema": "workspace:*",
    "@draftroom/contracts": "workspace:*",
    "@draftroom/dev-assets": "workspace:*",
    "@draftroom/permissions": "workspace:*",
    "@draftroom/tldraw-import": "workspace:*",
    "@tldraw/sync-core": "catalog:",
    "@tldraw/tlschema": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@excalidraw/element": "catalog:",
    "@types/ws": "catalog:"
  }
}
