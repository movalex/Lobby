# LOCAL DEVELOPMENT ONLY. Loaded by `pnpm dev` via --env-file; never by `start` or any deployment.
# DRAFTROOM_DEV_AUTH=1 enables unauthenticated ?devUser= identities and the /dev-api + /files routes.
DRAFTROOM_DEV_AUTH=1
DRAFTROOM_DATA_DIR=../../.data
HOST=127.0.0.1
PORT=5858
DRAFTROOM_API_INTERNAL_URL=http://127.0.0.1:5859
# Dev-only secrets (rejected when NODE_ENV=production). Must match apps/api/dev.env.
DRAFTROOM_TICKET_SECRET=dev-only-ticket-secret-change-me-0123456789
DRAFTROOM_INTERNAL_SECRET=dev-only-internal-secret-change-me-0123456789
