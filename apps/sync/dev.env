# LOCAL DEVELOPMENT ONLY. Loaded by `pnpm dev` via --env-file; never by `start` or any deployment.
# Connections are admitted only with a board ticket signed by the API (dev identities come from the
# API's dev login); the secrets below must match apps/api/dev.env.
DRAFTROOM_DATA_DIR=../../.data
HOST=127.0.0.1
PORT=5858
DRAFTROOM_API_INTERNAL_URL=http://127.0.0.1:5859
# Dev-only secrets (rejected when NODE_ENV=production).
DRAFTROOM_TICKET_SECRET=dev-only-ticket-secret-change-me-0123456789
DRAFTROOM_INTERNAL_SECRET=dev-only-internal-secret-change-me-0123456789
# wave N (N2-5): emoji reactions on notes (the code default is off, fail-closed; render.yaml sets on)
DRAFTROOM_REACTIONS=on
