{
  "name": "draftroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @draftroom/e2e test",
    "e2e:install": "pnpm --filter @draftroom/e2e install-browsers",
    "fixtures": "pnpm --filter @draftroom/worker fixtures",
    "lint": "biome check .",
    "format": "biome check --write .",
    "licence:check": "node scripts/licence-check.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm e2e",
    "test:arrows": "vitest run -c vitest.arrows.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
