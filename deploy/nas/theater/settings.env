# The theater Lobby's non-secret settings. deploy-theater.sh uploads this file as the compose project's .env.
# Secrets never go here: they are created on the NAS (secrets/), and the tunnel token comes from .env.tunnel.

# The address people open (the Cloudflare Tunnel's public hostname).
LOBBY_ORIGIN=https://lobby.banzerinihouse.org
LOBBY_WORKSPACE_NAME=Banzerini House

# How people sign in: google ("Continue with Google", any Google account, any domain) and/or email (type
# any address and a name, nothing verified). google needs LOBBY_GOOGLE_CLIENT_ID: a Web OAuth client whose
# Authorized JavaScript origins include LOBBY_ORIGIN (public by design, not a secret).
LOBBY_SIGNIN_METHODS=email
LOBBY_GOOGLE_CLIENT_ID=
