{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.data",
      "!**/test-results",
      "!**/playwright-report",
      "!docs/research",
      "!**/.claude"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@excalidraw/*", "@excalidraw/**"],
                "message": "Only apps/web/src/canvas/**, apps/web/test/engine-probe/** and packages/canvas-schema/src/engine/** may import @excalidraw/* (docs/EXCALIDRAW-MIGRATION.md §2.3.1). Go through the canvas port or the canvas-schema engine wrappers."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/canvas/**",
        "apps/web/test/engine-probe/**",
        "packages/canvas-schema/src/engine/**"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
