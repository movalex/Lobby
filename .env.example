# Draftroom environment reference (docs/M1-CONTRACTS.md §1, docs/M0-CONTRACTS.md §2, docs/DEPLOY.md).
#
# Nothing loads this file automatically. Local development uses apps/*/dev.env (loaded by `pnpm dev`
# through `node --env-file`); deployments set real values in the platform (render.yaml + Render
# dashboard; the NAS worker's env file, deploy/nas/README.md). Every value below is a SAFE PLACEHOLDER:
# never commit real secrets, keys, tokens or tickets. Real R2 credentials for the opt-in live tests live
# only in the gitignored .env.deploy.local (they run only with DRAFTROOM_LIVE_R2=1; the e2e stack uses a
# real bucket only with E2E_BLOB_STORE=r2 plus the four R2_* values in its environment).
# All processes refuse to start on invalid configuration. With NODE_ENV=production the dev defaults
# for secrets, DRAFTROOM_DEV_AUTH=1 and AUTH_PROVIDER=dev are rejected, and the api's PUBLIC_ORIGIN +
# DRAFTROOM_SYNC_INTERNAL_URL and sync's DRAFTROOM_API_INTERNAL_URL + ALLOWED_ORIGINS are REQUIRED
# (no loopback defaults: a wrong internal address fails silently, and sync's access re-checks fail open).
# The api always requires DRAFTROOM_WORKER_TOKEN (+ the R2_* values with DRAFTROOM_BLOB_STORE=r2); the
# worker requires DRAFTROOM_API_URL + DRAFTROOM_WORKER_TOKEN.

# ---- shared: api, sync (the worker needs neither of these data settings) --------------------------
NODE_ENV=production
# Local disk: rooms/ (sync), blobs/ (api, only with DRAFTROOM_BLOB_STORE=fs), pg/ (api, only without
# DATABASE_URL). Never on a network share. On Render: sync's persistent disk mount, /var/data; the api
# has no disk there and uses a scratch path (/tmp/draftroom-api) because it keeps nothing durable.
DRAFTROOM_DATA_DIR=/var/data
# Local development ONLY (enables development sign-in). Leave unset in every deployment.
# DRAFTROOM_DEV_AUTH=1
# api signs board tickets, sync verifies them. >= 32 chars, random, different from the internal secret.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DRAFTROOM_TICKET_SECRET=replace-with-32+-random-characters-ticket
# api <-> sync internal calls (x-draftroom-internal header). >= 32 chars, random, not the ticket secret.
DRAFTROOM_INTERNAL_SECRET=replace-with-32+-random-characters-internal

# ---- api (apps/api) ------------------------------------------------------------------------------
# Bind address. Containers and Render need 0.0.0.0 (the images set it); local dev uses 127.0.0.1.
HOST=0.0.0.0
# Render injects PORT (default 10000). Local default: 5859.
PORT=5859
# Postgres connection string. Unset = PGlite (in-process PostgreSQL) at ${DRAFTROOM_DATA_DIR}/pg.
DATABASE_URL=postgresql://draftroom:replace-me@db-host:5432/draftroom
# Rollbacks only (docs/DEPLOY.md "Rollback"): 1 lets this build start on a database that already has
# migrations newer than it knows (it warns on every start). Leave unset otherwise.
# DRAFTROOM_ALLOW_NEWER_SCHEMA=1
# The sync server's internal endpoints: a full http(s) URL, or host:port (what a Render Blueprint's
# fromService.property: hostport injects), which becomes http://host:port. Default (development only)
# http://127.0.0.1:5858. Under NODE_ENV=production: required, and loopback addresses are refused.
DRAFTROOM_SYNC_INTERNAL_URL=sync-internal-host:10000
# Exact browser origin: Origin checks on mutating requests, cookie Secure flag, invite links.
# Under NODE_ENV=production: required and https. Default (development only) http://127.0.0.1:5173.
PUBLIC_ORIGIN=https://draftroom.example.com
# Which X-Forwarded-For entries to believe for req.ip (the per-IP sign-in / invitation rate limits):
#   unset / false / 0  the socket peer is the client (right when nothing proxies the api)
#   N (1-10)           exactly N proxies that APPEND to X-Forwarded-For sit in front of every request;
#                      the address N hops back is the client (Render: 3; see docs/DEPLOY.md)
#   a,b,c              trusted proxy IPs / CIDRs / loopback, linklocal, uniquelocal presets
#   true               trust every entry: only behind a proxy that REPLACES the header (spoofable otherwise)
TRUST_PROXY=3
# dev (local only, needs DRAFTROOM_DEV_AUTH=1) or clerk. The Clerk adapter is UNVERIFIED until keys exist.
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Domain access (docs/DOMAIN-ACCESS-CONTRACTS.md §2): who may create workspaces, projects and boards and
# hand out access ("creators"). Always on; no value turns it off.
# Creator domains: exact, comma-separated, ASCII (internationalised domains in punycode, xn--...). Unset
# or blank = darkburn.com,trailerparkgroup.com (in every environment). Subdomains are separate entries.
# DRAFTROOM_CREATOR_DOMAINS=darkburn.com,trailerparkgroup.com
# Exceptions: exact addresses, comma-separated, at most 50, never a +clerk_test address. Unset = none. Set
# the real value in the Render Dashboard only, never in git (the startup log shows only how many there are).
# DRAFTROOM_CREATOR_EMAILS=owner@personal.example.test
# Who reads the feedback inbox (/feedback) and marks items done (wave J5, docs/DEPLOY.md "Send feedback"): exact verified
# sign-in addresses, comma-separated, at most 25. Unset = nobody reads it through the app. Set the real value in the
# Render Dashboard only, never in git. With the dev provider a handle's address is <handle>@dev.invalid.
# DRAFTROOM_FEEDBACK_ADMINS=alice@dev.invalid
# Fastify log level (request lines carry route patterns only, never URLs or query strings).
LOG_LEVEL=info
# Where uploaded originals and derivatives live (docs/M3-STORAGE-CONTRACTS.md §1, §6):
#   fs  ${DRAFTROOM_DATA_DIR}/blobs on local disk (the default outside production): development, e2e,
#       single-host installs with a persistent volume
#   r2  Cloudflare R2 (Render staging); requires the four R2_* values below
# Required (no default) under NODE_ENV=production.
DRAFTROOM_BLOB_STORE=r2
# Per-workspace upload limits: stored originals (MB, default 2048), files (default 5000), and
# uploads per person per minute (default 120).
# DRAFTROOM_WORKSPACE_QUOTA_MB=102400
# DRAFTROOM_WORKSPACE_MAX_FILES=5000
# DRAFTROOM_UPLOADS_PER_MINUTE=120
# The quota counts everything a workspace stores: originals, their previews and board thumbnails.
# What ONE name-only guest (no account) may upload to a workspace (MB, default 1024; files, default
# 200), and boards per workspace, trashed ones included (default 10000).
# DRAFTROOM_GUEST_QUOTA_MB=1024
# DRAFTROOM_GUEST_MAX_FILES=200
# DRAFTROOM_WORKSPACE_MAX_BOARDS=10000
# Collector of uploaded files nothing references any more (apps/api/src/files/gc.ts): off | report
# (default: marks and reports them to workspace owners, never deletes) | delete (also deletes files
# unreferenced for 30 days: originals, previews, rows, with an audit event). Passes every N minutes.
# DRAFTROOM_ASSET_GC=report
# DRAFTROOM_ASSET_GC_INTERVAL_MIN=360
# Cloudflare R2: the api (files) and, with DRAFTROOM_BACKUP_STORE=r2, sync (offsite board backups).
# Workers get short-lived presigned URLs; the browser never talks to R2. Use a
# bucket-scoped "Object Read & Write" API token, never an account-wide one (docs/DEPLOY.md).
# The Cloudflare account ID: 32 lowercase hex characters.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=draftroom-staging
# Optional https origin of the S3 endpoint. Default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com;
# set it only for a bucket in a jurisdiction (e.g. https://<account>.eu.r2.cloudflarestorage.com).
# R2_ENDPOINT=
# Bearer token of the preview workers (Authorization: Bearer ...; /api/worker/* only). >= 32 chars,
# random, the SAME value on the api and every worker, different from the two secrets above; dev
# placeholders (dev-only-...) are refused in production. It lets a worker read originals of queued
# uploads and write their derivatives, nothing else.
DRAFTROOM_WORKER_TOKEN=replace-with-32+-random-characters-worker
# Wave R, notifications to Slack and Teams (apps/api/src/crypto/sealed.ts): the key webhook URLs are sealed
# with at rest (AES-256-GCM). >= 32 chars, random, different from every other secret. Unset: chat hooks are
# off (fail closed). While rotating, the old value goes in _PREVIOUS (it only opens); without it, saved
# hooks must be pasted again. Render: its own env group, linked to the api only (render.yaml).
# DRAFTROOM_WEBHOOK_SECRET=replace-with-32+-random-characters-webhook
# DRAFTROOM_WEBHOOK_SECRET_PREVIOUS=
# Wave R test seams, local development ONLY (they require DRAFTROOM_DEV_AUTH=1): the e2e fake Miro server
# (<api origin>,<files origin>) and fake webhook receiver (<slack origin>[,<teams origin>]).
# DRAFTROOM_MIRO_TEST_ORIGINS=http://127.0.0.1:7801,http://127.0.0.1:7802
# DRAFTROOM_CHAT_HOOK_TEST_ORIGINS=http://127.0.0.1:7811
# AI on the board (apps/api/src/features/ai): Summarize, Group into themes, Action items, Generate
# ideas, through OpenAI's chat completions. Without OPENAI_API_KEY the feature is hidden. The key has
# NO spending cap at OpenAI: the limits below are the only brake, enforced by the api per call, per
# person, per workspace and for the whole of Lobby, from the ai_usage table (they survive restarts).
# Secret: never commit it, never log it (Render: sync: false).
# OPENAI_API_KEY=
# Model (default gpt-5.4-mini) and endpoint (default https://api.openai.com/v1; https in production).
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Kill switch: off hides AI and refuses every call without contacting OpenAI (default on).
# DRAFTROOM_AI=on
# Per call: prompt tokens (estimated conservatively; board text beyond it is left out) and
# max_completion_tokens (reasoning included); the whole request's timeout in ms.
# DRAFTROOM_AI_MAX_INPUT_TOKENS=12000
# DRAFTROOM_AI_MAX_OUTPUT_TOKENS=1500
# DRAFTROOM_AI_TIMEOUT_MS=30000
# Calls per person per hour (failed ones count too), and tokens per UTC day: per workspace (owners
# see "AI budget used today: N%"), per person across workspaces, and for all of Lobby.
# DRAFTROOM_AI_CALLS_PER_HOUR=20
# DRAFTROOM_AI_DAILY_TOKENS=400000
# DRAFTROOM_AI_USER_DAILY_TOKENS=150000
# DRAFTROOM_AI_GLOBAL_DAILY_TOKENS=2000000
# reasoning_effort sent with each call: none | minimal | low (default) | medium | high, or off to leave
# the parameter out (models without it).
# DRAFTROOM_AI_REASONING_EFFORT=low

# ---- sync (apps/sync) ----------------------------------------------------------------------------
# HOST / PORT as above (local default port 5858).
# The api's internal endpoints: http(s) URL or host:port, same rules as DRAFTROOM_SYNC_INTERNAL_URL.
# Default (development only) http://127.0.0.1:5859; required and non-loopback under NODE_ENV=production.
DRAFTROOM_API_INTERNAL_URL=api-internal-host:10000
# Browser origins whose pages may open a board WebSocket (comma- or space-separated, exact
# scheme://host[:port]). Checked before the upgrade; the ticket stays the authentication. Required and
# https-only under NODE_ENV=production; unset in development = no Origin check (the Vite proxy).
ALLOWED_ORIGINS=https://draftroom.example.com
# How often (ms) every (board, user) with live sessions is re-checked against the api.
ACCESS_RECHECK_MS=10000
# Idle room eviction (ms) and text-edit lease length (ms).
IDLE_EVICT_MS=30000
TEXT_LEASE_MS=5000
# Offsite copies of each consistent board backup (docs/DEPLOY.md "Backups"): off (default, also in
# production), fs (${DRAFTROOM_DATA_DIR}/blobs; tests and single-host installs) or r2 (objects under
# backups/sync/). Every manifest entry, manifest and index is signed with a key derived from
# DRAFTROOM_BACKUP_SIGNING_SECRET (below); the restore tools need that same secret to verify them.
DRAFTROOM_BACKUP_STORE=r2
# The backup signing secret: the sync service's own (never the api's), 32+ random characters, different
# from both secrets above. Required in production whenever the store is on; without it, outside production,
# backups are signed with a key derived from DRAFTROOM_INTERNAL_SECRET, which then only verifies older ones.
DRAFTROOM_BACKUP_SIGNING_SECRET=replace-with-32+-random-characters-backup-signing
# Recommended: the backups' own bucket and a token scoped to it alone. Each value set here replaces its
# R2_* counterpart for backups only (the two credentials together or not at all); with the bucket and
# both credentials set, sync needs none of the api's R2_* token values. Unset = the shared R2_* above.
# DRAFTROOM_BACKUP_R2_BUCKET=draftroom-staging-backups
# DRAFTROOM_BACKUP_R2_ACCESS_KEY_ID=replace-with-backup-only-r2-access-key-id
# DRAFTROOM_BACKUP_R2_SECRET_ACCESS_KEY=replace-with-backup-only-r2-secret-access-key
# Only for a bucket in another Cloudflare account, or in a jurisdiction:
# DRAFTROOM_BACKUP_R2_ACCOUNT_ID=replace-with-other-cloudflare-account-id
# DRAFTROOM_BACKUP_R2_ENDPOINT=
# How often open boards that changed are backed up (ms; default 900000 = 15 min).
# DRAFTROOM_BACKUP_INTERVAL_MS=900000

# ---- worker (apps/worker) ------------------------------------------------------------------------
# The worker talks to the api over HTTP only (docs/M3-STORAGE-CONTRACTS.md §4-§5): no database, no
# R2 keys, no DRAFTROOM_DATA_DIR.
# The api's origin (no path): an https URL, or host:port (becomes http://host:port). Under
# NODE_ENV=production plain http is refused except for private-network hosts (single-label names such as
# Render's hostport, RFC 1918 / loopback addresses), because the token rides on every request.
# The NAS worker uses the api's public URL; the optional Render background worker gets the api's private
# host:port from the Blueprint (docs/DEPLOY.md "Preview workers").
DRAFTROOM_API_URL=https://draftroom-api.example.com
# DRAFTROOM_WORKER_TOKEN: the same value as the api's (see the api section above).
# Lease owner name reported to the api. Default: the hostname. Must differ between concurrent workers.
# WORKER_ID=nas-worker-1
# Jobs processed at the same time by this process (default 1). Each one needs RAM for its PDF child
# (WORKER_PDF_HEAP_MB) and temp space for its original (up to 500 MB).
WORKER_CONCURRENCY=1
# Idle poll interval in ms (default 2000); doubles with jitter while there is no work, up to
# WORKER_POLL_MAX_MS (default 15000).
WORKER_POLL_MS=2000
# WORKER_POLL_MAX_MS=15000
# Heap cap (MB) of the PDF rendering child process (default 384; the Render 512 MB worker uses 256).
WORKER_PDF_HEAP_MB=384
# How long (ms) a stopping worker may finish its current job before releasing it (default 10000).
WORKER_SHUTDOWN_GRACE_MS=10000
# Absolute directory for per-job temp files (default: the OS temp dir, /tmp in the image). Budget
# >= 1 GB per concurrent job (a 500 MB video original plus derivatives).
# WORKER_TMP_DIR=/tmp
# Default: ffmpeg / ffprobe from PATH (the worker image installs Debian's ffmpeg).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---- web (apps/web): build-time only, inlined into the bundle by Vite ----------------------------
# tldraw license key. Without a key whose hosts include the serving hostname, the editor goes blank
# 5 s after load on any HTTPS host (docs/research/license.md). Public by design; still not committed.
VITE_TLDRAW_LICENSE_KEY=
# Where the board WebSocket goes: unset = the page's own origin (the Vite proxy, or an edge that proxies
# /connect). Set it when the web host cannot proxy WebSockets (a Render static site), e.g.
# https://draftroom-sync.example.com (https -> wss). Origin only (http(s) or ws(s)); an invalid value
# is reported in the browser console and the page origin is used. Sync's ALLOWED_ORIGINS must then list
# the WEB origin (the page's origin is what the browser sends). Changing it needs a rebuild.
# VITE_DRAFTROOM_SYNC_ORIGIN=https://draftroom-sync.example.com
# "1" builds development identities into the bundle: e2e only, NEVER for a deployment.
# VITE_DRAFTROOM_DEV_AUTH=1
# Local dev/preview only: Vite port and proxy targets (the browser talks to one origin; Vite proxies
# /api + /files to the api and /connect to sync). Not used by the Render static site.
# WEB_PORT=5173
# DRAFTROOM_API_ORIGIN=http://127.0.0.1:5859
# DRAFTROOM_SYNC_ORIGIN=http://127.0.0.1:5858
