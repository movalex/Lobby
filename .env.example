# Draftroom environment reference (docs/M1-CONTRACTS.md §1, docs/M0-CONTRACTS.md §2, docs/DEPLOY.md).
#
# Nothing loads this file automatically. Local development uses apps/*/dev.env (loaded by `pnpm dev`
# through `node --env-file`); deployments set real values in the platform (render.yaml + Render
# dashboard). Every value below is a SAFE PLACEHOLDER: never commit real secrets, keys or tickets.
# All processes refuse to start on invalid configuration. With NODE_ENV=production the dev defaults
# for secrets, DRAFTROOM_DEV_AUTH=1 and AUTH_PROVIDER=dev are rejected.

# ---- shared: api, sync, worker -------------------------------------------------------------------
NODE_ENV=production
# Local disk store: rooms/ (sync), assets/ + jobs/ (api + worker), pg/ (api, only without DATABASE_URL).
# Never on a network share. On Render: the persistent disk mount, /var/data.
DRAFTROOM_DATA_DIR=/var/data
# Local development ONLY (enables development sign-in). Leave unset in every deployment.
# DRAFTROOM_DEV_AUTH=1
# api signs board tickets, sync verifies them. >= 32 chars, random, different from the internal secret.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DRAFTROOM_TICKET_SECRET=replace-with-32+-random-characters-ticket
# api <-> sync internal calls (x-draftroom-internal header). >= 32 chars, random, not the ticket secret.
DRAFTROOM_INTERNAL_SECRET=replace-with-32+-random-characters-internal

# ---- api (apps/api) ------------------------------------------------------------------------------
# Bind address. Containers and Render need 0.0.0.0 (the images set it); local dev uses 127.0.0.1.
HOST=0.0.0.0
# Render injects PORT (default 10000). Local default: 5859.
PORT=5859
# Postgres connection string. Unset = PGlite (in-process PostgreSQL) at ${DRAFTROOM_DATA_DIR}/pg.
DATABASE_URL=postgresql://draftroom:replace-me@db-host:5432/draftroom
# Base URL of the sync server's internal endpoints. Default http://127.0.0.1:5858.
DRAFTROOM_SYNC_INTERNAL_URL=http://sync-internal-host:10000
# Exact browser origin: Origin checks on mutating requests, cookie Secure flag, invite links.
# Must be https under NODE_ENV=production. Default http://127.0.0.1:5173.
PUBLIC_ORIGIN=https://draftroom.example.com
# dev (local only, needs DRAFTROOM_DEV_AUTH=1) or clerk. The Clerk adapter is UNVERIFIED until keys exist.
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Fastify log level (request lines carry route patterns only, never URLs or query strings).
LOG_LEVEL=info

# ---- sync (apps/sync) ----------------------------------------------------------------------------
# HOST / PORT as above (local default port 5858).
# Base URL of the api's internal endpoints. Default http://127.0.0.1:5859.
DRAFTROOM_API_INTERNAL_URL=http://api-internal-host:10000
# How often (ms) every (board, user) with live sessions is re-checked against the api.
ACCESS_RECHECK_MS=10000
# Idle room eviction (ms) and text-edit lease length (ms).
IDLE_EVICT_MS=30000
TEXT_LEASE_MS=5000

# ---- worker (apps/worker) ------------------------------------------------------------------------
# Default: ffmpeg / ffprobe from PATH (the worker images install Debian's ffmpeg).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
WORKER_POLL_MS=500
WORKER_SHUTDOWN_GRACE_MS=10000

# ---- web (apps/web): build-time only, inlined into the bundle by Vite ----------------------------
# tldraw license key. Without a key whose hosts include the serving hostname, the editor goes blank
# 5 s after load on any HTTPS host (docs/research/license.md). Public by design; still not committed.
VITE_TLDRAW_LICENSE_KEY=
# "1" builds development identities into the bundle: e2e only, NEVER for a deployment.
# VITE_DRAFTROOM_DEV_AUTH=1
# Local dev/preview only: Vite port and proxy targets (the browser talks to one origin; Vite proxies
# /api + /files to the api and /connect to sync). Not used by the Render static site.
# WEB_PORT=5173
# DRAFTROOM_API_ORIGIN=http://127.0.0.1:5859
# DRAFTROOM_SYNC_ORIGIN=http://127.0.0.1:5858
